{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "isolatedModules": true
  },
  "include": ["src", "spikes", "bridge", "vite.config.ts", "../runner/src/protocol.ts", "../runner/src/platform.ts", "../web/src/sections.ts", "../web/src/turns.ts", "../web/src/format.ts"]
}
