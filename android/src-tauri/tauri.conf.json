{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Threadbear",
  "version": "0.1.0",
  "identifier": "com.tinkerware.threadbear",
  "build": {
    "frontendDist": "../../web/dist-app",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Threadbear" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "publisher": "Platima",
    "copyright": "Copyright (c) 2026 Mike Cann",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "android": { "minSdkVersion": 26 }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["threadbear"], "host": "pair", "appLink": false }]
    }
  }
}
